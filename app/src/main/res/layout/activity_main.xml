<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="#0F1115">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#1A1D22"
        android:padding="16dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MEDIA PLAYER"
            android:textColor="#5C6BC0"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="READY"
            android:textColor="#E8EAF6"
            android:textSize="18sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Источники -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <Button android:id="@+id/btnHttp"
            android:layout_width="0dp" android:layout_height="56dp"
            android:layout_weight="1" android:layout_margin="4dp"
            android:text="@string/http" android:textColor="#FFFFFF"
            android:textSize="10sp" android:backgroundTint="#2A2E36"
            android:onClick="onClick"/>

        <Button android:id="@+id/btnStream"
            android:layout_width="0dp" android:layout_height="56dp"
            android:layout_weight="1" android:layout_margin="4dp"
            android:text="@string/stream" android:textColor="#FFFFFF"
            android:textSize="10sp" android:backgroundTint="#2A2E36"
            android:onClick="onClick"/>

        <Button android:id="@+id/btnSd"
            android:layout_width="0dp" android:layout_height="56dp"
            android:layout_weight="1" android:layout_margin="4dp"
            android:text="@string/sd" android:textColor="#FFFFFF"
            android:textSize="10sp" android:backgroundTint="#2A2E36"
            android:onClick="onClick"/>

        <Button android:id="@+id/btnUri"
            android:layout_width="0dp" android:layout_height="56dp"
            android:layout_weight="1" android:layout_margin="4dp"
            android:text="@string/uri" android:textColor="#FFFFFF"
            android:textSize="10sp" android:backgroundTint="#2A2E36"
            android:onClick="onClick"/>

        <Button android:id="@+id/btnRaw"
            android:layout_width="0dp" android:layout_height="56dp"
            android:layout_weight="1" android:layout_margin="4dp"
            android:text="@string/raw" android:textColor="#FFFFFF"
            android:textSize="10sp" android:backgroundTint="#2A2E36"
            android:onClick="onClick"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <Button android:id="@+id/btnPause"
            android:layout_width="0dp" android:layout_height="56dp"
            android:layout_weight="1" android:layout_margin="4dp"
            android:text="@string/pause" android:textColor="#FFFFFF"
            android:textSize="10sp" android:backgroundTint="#FB8C00"
            android:onClick="onClick"/>

        <Button android:id="@+id/btnResume"
            android:layout_width="0dp" android:layout_height="56dp"
            android:layout_weight="1" android:layout_margin="4dp"
            android:text="@string/resume" android:textColor="#FFFFFF"
            android:textSize="10sp" android:backgroundTint="#43A047"
            android:onClick="onClick"/>

        <Button android:id="@+id/btnStop"
            android:layout_width="0dp" android:layout_height="56dp"
            android:layout_weight="1" android:layout_margin="4dp"
            android:text="@string/stop" android:textColor="#FFFFFF"
            android:textSize="10sp" android:backgroundTint="#E53935"
            android:onClick="onClick"/>

        <CheckBox
            android:id="@+id/chbLoop"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_margin="4dp"
            android:gravity="center"
            android:buttonTint="#1E88E5"
            android:textColor="#E8EAF6"
            android:textSize="10sp"
            android:text="@string/loop"/>
    </LinearLayout>

    <!-- Перемотка -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button android:id="@+id/btnBackward"
            android:layout_width="0dp" android:layout_height="56dp"
            android:layout_weight="1" android:layout_margin="4dp"
            android:text="@string/backward" android:textColor="#FFFFFF"
            android:textSize="10sp" android:backgroundTint="#546E7A"
            android:onClick="onClick"/>

        <Button android:id="@+id/btnForward"
            android:layout_width="0dp" android:layout_height="56dp"
            android:layout_weight="1" android:layout_margin="4dp"
            android:text="@string/forward" android:textColor="#FFFFFF"
            android:textSize="10sp" android:backgroundTint="#546E7A"
            android:onClick="onClick"/>

        <Button android:id="@+id/btnInfo"
            android:layout_width="0dp" android:layout_height="56dp"
            android:layout_weight="1" android:layout_margin="4dp"
            android:text="@string/info" android:textColor="#FFFFFF"
            android:textSize="10sp" android:backgroundTint="#8E24AA"
            android:onClick="onClick"/>
    </LinearLayout>
</LinearLayout>